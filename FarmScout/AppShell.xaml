<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FarmScout.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FarmScout.Views"
    >
    <FlyoutItem Title="Home" Icon="home.png" FlyoutDisplayOptions="AsMultipleItems" >
        <Tab Title="Dashboard">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>
        <Tab Title="Observations">
            <ShellContent ContentTemplate="{DataTemplate views:ObservationsPage}" />
        </Tab>
    </FlyoutItem>
    <FlyoutItem Title="Security" Icon="home.png">
        <Tab Title="ASSshboard">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>
        <Tab Title="Observaticccons">
            <ShellContent ContentTemplate="{DataTemplate views:ObservationsPage}" />
        </Tab>
    </FlyoutItem>
    <ShellContent Title="Settings" ContentTemplate="{DataTemplate views:SettingsPage}" />

</Shell>
